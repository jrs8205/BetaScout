{
  "name": "betascout-catalog",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "kv_namespaces": [
    { "binding": "CATALOG", "id": "5deb2577b8524356a98468b5fb60f5df" }
  ],
  // Per-source damping for POST /hints. The app neither stores nor logs the
  // key (client IP) — it is only handed to the platform's limiter, honouring
  // PRIVACY.md's "no IP logging". 10 posts/min is far above a real device's
  // 1-3 per scan.
  "ratelimits": [
    {
      "name": "HINT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Atomic global daily package budget (stores a day number and a count only).
  "durable_objects": {
    "bindings": [{ "name": "HINT_BUDGET", "class_name": "HintBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HintBudget"] }]
}
