    <!-- Onboarding -->
    <string name="onboarding_title">Boas-vindas ao BetaScout</string>
    <string name="onboarding_what">O BetaScout verifica seus apps instalados, mostra quais deles têm um programa beta conhecido no Google Play, abre a página de inscrição por você e lembra de conferir os apps que você acompanha.</string>
    <string name="onboarding_honesty_title">O que o BetaScout não faz</string>
    <string name="onboarding_honesty">Ele nunca entra em programas beta por você. Ao fazer login com o Google, suas participações e o status aberto/lotado de cada programa são lidos das suas próprias páginas de teste; sem login, você mesmo confere.</string>
    <string name="onboarding_risk">Fazer login é opcional. Conectado, o BetaScout lê suas próprias páginas de teste pela sua sessão do Google em um ritmo leve e limitado. A leitura automática é uma área cinzenta nos termos do Google, então um pequeno risco para a conta não pode ser descartado — o catálogo e os lembretes funcionam sem login.</string>
    <string name="onboarding_notifications">Permita as notificações para que o BetaScout possa lembrar você de conferir os status dos betas.</string>
    <string name="onboarding_continue">Começar</string>

