<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The session cookie (settings DataStore), the account-scoped scrape
         observations (Room DB) and the login WebView's persisted Google cookies
         (app_webview/) must never leave the device via backup. -->
    <exclude
        domain="file"
        path="datastore/settings.preferences_pb" />
    <exclude
        domain="database"
        path="betascout.db" />
    <exclude
        domain="root"
        path="app_webview" />
</full-backup-content>
